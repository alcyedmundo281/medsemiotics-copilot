# ==============================================================================
# MedSemiotics Teaching Copilot - Environment Configuration Template
# Copy this file to .env and fill in your local development values.
# NEVER commit .env or any file containing real credentials to version control.
# ==============================================================================

# Google Workspace / Calendar / Classroom / Drive Integration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PROJECT_ID=
GOOGLE_CALENDAR_CREDENTIALS_FILE=
GOOGLE_CALENDAR_TOKEN_FILE=

# Google Classroom metadata-only read boundary (Apps Script web app, Loop 0.6B)
# The dedicated Workspace account owns the deployment and its persistent authorization.
MEDSEMIOTICS_CLASSROOM_APPS_SCRIPT_URL=
MEDSEMIOTICS_CLASSROOM_APPS_SCRIPT_DEPLOYMENT_ID=
# Operator identity used to call the deployment (Loop 0.6F). Keys never belong in Git.
MEDSEMIOTICS_CLASSROOM_SERVICE_ACCOUNT_FILE=
MEDSEMIOTICS_CLASSROOM_IMPERSONATED_SUBJECT=
MEDSEMIOTICS_CLASSROOM_CALLER_SCOPES=

# LLM / Reasoning Services
MEDSEMIOTICS_LLM_PROVIDER=deterministic
MEDSEMIOTICS_OPENAI_MODEL=
MEDSEMIOTICS_ANTHROPIC_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Academic & Literature Integrations
PUBMED_API_KEY=

# PowerSemiotics CMS Integration
POWERSEMIOTICS_BASE_URL=
