# ==============================================================================
# MedSemiotics Teaching Copilot - Environment Configuration Template
# Copy this file to .env and fill in your local development values.
# NEVER commit .env or any file containing real credentials to version control.
# ==============================================================================

# Google Workspace / Calendar / Classroom / Drive Integration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PROJECT_ID=
GOOGLE_CALENDAR_CREDENTIALS_FILE=
GOOGLE_CALENDAR_TOKEN_FILE=

# LLM / Reasoning Services
MEDSEMIOTICS_LLM_PROVIDER=deterministic
MEDSEMIOTICS_OPENAI_MODEL=
MEDSEMIOTICS_ANTHROPIC_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Academic & Literature Integrations
PUBMED_API_KEY=

# PowerSemiotics CMS Integration
POWERSEMIOTICS_BASE_URL=
