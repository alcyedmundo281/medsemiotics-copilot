# ==============================================================================
# MedSemiotics Teaching Copilot - Environment Configuration Template
# Copy this file to .env and fill in your local development values.
# NEVER commit .env or any file containing real credentials to version control.
# ==============================================================================

# Google Workspace / Calendar / Classroom / Drive Integration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PROJECT_ID=
GOOGLE_CALENDAR_CREDENTIALS_FILE=
GOOGLE_CALENDAR_TOKEN_FILE=

# Google Classroom metadata-only read boundary (Apps Script web app, Loop 0.6B)
# The dedicated Workspace account owns the deployment and its persistent authorization.
MEDSEMIOTICS_CLASSROOM_APPS_SCRIPT_URL=
MEDSEMIOTICS_CLASSROOM_APPS_SCRIPT_DEPLOYMENT_ID=
#
# Operator identity used to call the deployment. Credentials never belong in Git.
# Preferred caller (Loop 0.7E): the deployment owner's own credential, held by a secret manager.
# Set MEDSEMIOTICS_CLASSROOM_SECRET_DIR to a mounted secret volume, or provide these as variables.
# Mint the refresh token once with scripts/classroom_owner_authorize.py. Never commit any value.
MEDSEMIOTICS_CLASSROOM_SECRET_DIR=
MEDSEMIOTICS_CLASSROOM_OAUTH_CLIENT_ID=
MEDSEMIOTICS_CLASSROOM_OAUTH_CLIENT_SECRET=
MEDSEMIOTICS_CLASSROOM_OAUTH_REFRESH_TOKEN=

# Alternative caller: service account with domain-wide delegation, for Workspaces already using it.
MEDSEMIOTICS_CLASSROOM_SERVICE_ACCOUNT_FILE=
MEDSEMIOTICS_CLASSROOM_IMPERSONATED_SUBJECT=
MEDSEMIOTICS_CLASSROOM_CALLER_SCOPES=

# Calendar read credential for the backend (Loop 0.8C). Scoped to calendar.readonly by
# construction and kept separate from the Classroom caller above. Mint the refresh token with
# scripts/classroom_owner_authorize.py using the Calendar scope, then store it here.
MEDSEMIOTICS_CALENDAR_OAUTH_CLIENT_ID=
MEDSEMIOTICS_CALENDAR_OAUTH_CLIENT_SECRET=
MEDSEMIOTICS_CALENDAR_OAUTH_REFRESH_TOKEN=

# Read-only backend contracts (Loop 0.8A) consumed by mobile and conversational surfaces.
# The backend refuses to serve academic state without a token. Generate one with:
#   openssl rand -hex 32
MEDSEMIOTICS_API_TOKEN=
MEDSEMIOTICS_CONFIG_ROOT=
# Base URL a conversational surface or operator shell calls (Loop 0.8E).
MEDSEMIOTICS_API_BASE_URL=

# LLM / Reasoning Services
MEDSEMIOTICS_LLM_PROVIDER=deterministic
MEDSEMIOTICS_OPENAI_MODEL=
MEDSEMIOTICS_ANTHROPIC_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Academic & Literature Integrations
PUBMED_API_KEY=

# PowerSemiotics CMS Integration
POWERSEMIOTICS_BASE_URL=
